{
  "name": "reel-stitch",
  "version": "0.1.0",
  "description": "Turn one line of an idea into a short vertical video, locally, with open models.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "exports": {
    "./manifest": "./src/manifest/index.ts",
    "./prompt": "./src/prompt/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:prose": "node scripts/check-prose.ts",
    "check:mermaid": "node scripts/check-mermaid.ts"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
